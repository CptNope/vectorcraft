{
  "id": "./",
  "name": "VectorCraft — Community PWA",
  "short_name": "VectorCraft",
  "description": "Offline-capable progressive web app packaging of the open-source VectorCraft vector editor.",
  "start_url": "./",
  "scope": "./",
